{
  "version": 2,
  "builds": [
    { "src": "backend/server.js", "use": "@vercel/node" },
    { "src": "src/Mycomponents/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/server.js" },
    { "src": "/$", "dest": "src/Mycomponents/Home.js" },
    { "src": "/(.*)", "dest": "src/Mycomponents/$1" }
  ]
}
